# Display task information
display_task_info() {
    local task_data=$1
    local show_logs=$2
    
    local id=$(echo "$task_data" | jq -r '.id')
    local status=$(echo "$task_data" | jq -r '.status')
    local created=$(echo "$task_data" | jq -r '.created_at')
    local agent=$(echo "$task_data" | jq -r '.agent')
    local model=$(echo "$task_data" | jq -r '.model')
    local description=$(echo "$task_data" | jq -r '.description')
    local result=$(echo "$task_data" | jq -r '.result')
    local exec_time=$(echo "$task_data" | jq -r '.execution_time_seconds')
    
    echo ""
    success "Task Details"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "ID:          $id"
    echo "Status:      $status"
    echo "Agent:       $agent"
    echo "Model:       $model"
    echo "Description: $description"
    echo "Result:      $result"
    echo "Created:     $created"
    echo "Exec Time:   ${exec_time}s"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    
    if [[ "$show_logs" == true ]]; then
        display_task_logs "$id"
    fi
}

