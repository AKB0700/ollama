#!/usr/bin/env bash
set -e

# gh-agent-task - GitHub CLI extension for managing agent tasks
# This extension allows viewing and managing AI agent tasks

VERSION="0.1.0"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
error() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

info() {
    echo -e "${BLUE}$1${NC}"
}

success() {
    echo -e "${GREEN}$1${NC}"
}

warning() {
    echo -e "${YELLOW}$1${NC}"
}

# Validate UUID format
validate_uuid() {
    local uuid=$1
    if [[ ! $uuid =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
        error "Invalid UUID format: $uuid"
    fi
}

# Show help
show_help() {
    cat << EOF
gh-agent-task - GitHub CLI extension for managing agent tasks

USAGE:
  gh agent-task <command> [flags]

COMMANDS:
  view        View details of a specific agent task
  list        List all agent tasks
  logs        View logs for a specific agent task
  cancel      Cancel a running agent task
  version     Show version information

FLAGS:
  -h, --help     Show help for command

EXAMPLES:
  # View task details
  gh agent-task view dd1fee47-abb8-4a9c-b18e-60b512427f5f

  # View task with logs
  gh agent-task view dd1fee47-abb8-4a9c-b18e-60b512427f5f --log

  # List all tasks
  gh agent-task list

  # View only logs
  gh agent-task logs dd1fee47-abb8-4a9c-b18e-60b512427f5f

LEARN MORE:
  Use 'gh agent-task <command> --help' for more information about a command.
EOF
}

# View command
cmd_view() {
    local task_id=""
    local show_logs=false
    local format="table"
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --log|--logs)
                show_logs=true
                shift
                ;;
            --json)
                format="json"
                shift
                ;;
            -h|--help)
                show_view_help
                exit 0
                ;;
            -*)
                error "Unknown flag: $1"
                ;;
            *)
                if [[ -z "$task_id" ]]; then
                    task_id=$1
                else
                    error "Too many arguments"
                fi
                shift
                ;;
        esac
    done
    
    if [[ -z "$task_id" ]]; then
        error "Task ID is required. Usage: gh agent-task view <task-id> [--log]"
    fi
    
    validate_uuid "$task_id"
    
    # Get repository context
    local repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)
    if [[ -z "$repo" ]]; then
        # Fallback to git remote if gh is not authenticated
        repo=$(git remote get-url origin 2>/dev/null | sed 's/.*github.com[:/]\(.*\)\.git.*/\1/' || echo "unknown/unknown")
    fi
    
    # Only show info message in non-JSON mode
    if [[ "$format" != "json" ]]; then
        info "Fetching task $task_id from $repo..."
    fi
    
    # Try to find the task in GitHub Actions workflow runs
    # This is a placeholder - actual implementation would query a real API
    local task_data=$(fetch_task_data "$repo" "$task_id")
    
    if [[ -z "$task_data" ]]; then
        error "Task not found: $task_id"
    fi
    
    if [[ "$format" == "json" ]]; then
        echo "$task_data" | jq '.'
    else
        display_task_info "$task_data" "$show_logs"
    fi
}

# Fetch task data (placeholder implementation)
