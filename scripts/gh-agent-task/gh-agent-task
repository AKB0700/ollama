# Logs command (alias for view --log)
cmd_logs() {
    local task_id=$1
    if [[ -z "$task_id" ]]; then
        error "Task ID is required. Usage: gh agent-task logs <task-id>"
    fi
    cmd_view "$task_id" --log
}

# Version command
cmd_version() {
    echo "gh-agent-task version $VERSION"
}

# Main command dispatcher
main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi
    
    local command=$1
    shift
    
    case $command in
        view)
            cmd_view "$@"
            ;;
        list|ls)
            cmd_list "$@"
            ;;
        logs|log)
            cmd_logs "$@"
            ;;
        version|-v|--version)
            cmd_version
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            error "Unknown command: $command\n\nRun 'gh agent-task --help' for usage."
            ;;
    esac
}

# Run main
main "$@"
